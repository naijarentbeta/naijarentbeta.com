      \{ id: "lag-06", title: "2-Bedroom Shared Flat in Secure Close", location: "Gbagada", subArea: "Gbagada Phase 2", type: "2-Bed", price: 1200000, lat: 6.5562, lng: 3.3854, images: ["https://images.unsplash.com/photo-1600566753376-12c8ab7fb75b?auto=format&fit=crop&w=700&q=80"], nepaBand: "Band A (21 hrs)", floodScore: "9.5/10 Protected Close", prepaidMeter: "Solo Prepaid", waterStatus: "Treated System" \}\
    ];\
\
    let properties = [...DEFAULT_LISTINGS];\
    let favorites = [];\
    let leafletMapInstance = null;\
    let mapMarkers = [];\
    let isSplitMapActive = false;\
\
    function formatNaira(num) \{ return '\uc0\u8358 ' + Number(num).toLocaleString('en-NG'); \}\
\
    function toggleTheme() \{\
      document.documentElement.classList.toggle('dark');\
      localStorage.setItem('naija_theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');\
      lucide.createIcons();\
      if (leafletMapInstance) leafletMapInstance.invalidateSize();\
    \}\
\
    function toggleLanguage() \{\
      const label = document.getElementById('lang-label');\
      label.textContent = label.textContent === 'PIDGIN' ? 'ENGLISH' : 'PIDGIN';\
    \}\
\
    function renderListings(items = properties) \{\
      const grid = document.getElementById('listings-grid');\
      grid.innerHTML = items.map(item => `\
        <div class="glass-panel rounded-3xl overflow-hidden border border-slate-200 dark:border-dark-border hover:border-brand-500 transition-all duration-300 shadow-sm flex flex-col justify-between">\
          <div class="relative aspect-[16/10] bg-slate-900">\
            <img src="$\{item.images[0]\}" alt="$\{item.title\}" class="w-full h-full object-cover" />\
            <div class="absolute top-3 left-3 flex gap-1.5">\
              <span class="bg-brand-500 text-dark-bg font-extrabold text-[10px] px-2 py-0.5 rounded uppercase">NIN Verified</span>\
              <span class="bg-black/60 text-white font-bold text-[10px] px-2 py-0.5 rounded">$\{item.type\}</span>\
            </div>\
            <button onclick="openPropertyVideoModal('$\{item.id\}')" class="absolute inset-0 m-auto w-12 h-12 rounded-full bg-brand-500 text-dark-bg flex items-center justify-center shadow-xl">\
              <i data-lucide="play" class="w-6 h-6 fill-current ml-0.5"></i>\
            </button>\
            <div class="absolute bottom-2.5 left-3 text-white text-xs font-semibold flex items-center gap-1">\
              <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-400"></i> $\{item.subArea\}\
            </div>\
          </div>\
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">\
            <div>\
              <h3 class="text-sm font-extrabold text-slate-900 dark:text-white line-clamp-1">$\{item.title\}</h3>\
              <div class="grid grid-cols-2 gap-2 mt-3 text-[11px] font-semibold text-slate-600 dark:text-slate-300">\
                <span class="bg-slate-100 dark:bg-dark-surface px-2 py-1 rounded">\uc0\u9889  $\{item.nepaBand\}</span>\
                <span class="bg-slate-100 dark:bg-dark-surface px-2 py-1 rounded">\uc0\u55357 \u57057 \u65039  $\{item.floodScore\}</span>\
              </div>\
            </div>\
            <div class="pt-3 border-t border-slate-100 dark:border-dark-border flex items-center justify-between">\
              <div>\
                <div class="text-base font-black text-slate-900 dark:text-white">$\{formatNaira(item.price)\}<span class="text-xs font-normal text-slate-400">/yr</span></div>\
                <span class="text-[10px] font-bold text-emerald-600 dark:text-brand-400">\uc0\u8358 0 Roadside Fee</span>\
              </div>\
              <button onclick="quickWhatsAppContact('$\{item.title\}', '$\{item.price\}')" class="bg-emerald-500 hover:bg-emerald-600 text-dark-bg font-extrabold px-3 py-2 rounded-xl text-xs flex items-center gap-1">\
                <i data-lucide="message-circle" class="w-3.5 h-3.5 fill-current"></i> WhatsApp\
              </button>\
            </div>\
          </div>\
        </div>\
      `).join('');\
      lucide.createIcons();\
    \}\
\
    function runLiveFilters() \{\
      const loc = document.getElementById('filter-location').value;\
      const type = document.getElementById('filter-type').value;\
      const maxBudget = Number(document.getElementById('filter-budget').value);\
      const filtered = properties.filter(item => (loc === 'All' || item.location === loc) && (type === 'All' || item.type === type) && item.price <= maxBudget);\
      renderListings(filtered);\
    \}\
\
    function updateBudgetSlider(val) \{\
      document.getElementById('slider-val-label').textContent = formatNaira(val);\
      runLiveFilters();\
    \}\
\
    function filterByLocation(loc) \{\
      document.getElementById('filter-location').value = loc;\
      runLiveFilters();\
    \}\
\
    function resetFilters() \{\
      document.getElementById('filter-location').value = 'All';\
      document.getElementById('filter-type').value = 'All';\
      document.getElementById('filter-budget').value = '1500000';\
      document.getElementById('slider-val-label').textContent = formatNaira(1500000);\
      runLiveFilters();\
    \}\
\
    function toggleSplitMapView() \{\
      const panel = document.getElementById('split-map-panel');\
      const content = document.getElementById('content-container');\
      const btnText = document.getElementById('map-btn-text');\
      isSplitMapActive = !isSplitMapActive;\
      if (isSplitMapActive) \{\
        panel.classList.remove('hidden');\
        content.classList.add('lg:grid-cols-12');\
        document.getElementById('listings-wrapper').classList.add('lg:col-span-7');\
        panel.classList.add('lg:col-span-5');\
        btnText.textContent = "Grid Only";\
        if (!leafletMapInstance) \{\
          leafletMapInstance = L.map('leaflet-map').setView([6.5140, 3.3800], 12);\
          L.tileLayer('https://\{s\}.basemaps.cartocdn.com/rastertiles/voyager/\{z\}/\{x\}/\{y\}\{r\}.png').addTo(leafletMapInstance);\
          properties.forEach(item => \{\
            const icon = L.divIcon(\{ className: 'custom-icon', html: `<div class="map-price-pill">\uc0\u55356 \u57312  $\{formatNaira(item.price)\}</div>` \});\
            L.marker([item.lat, item.lng], \{ icon \}).addTo(leafletMapInstance);\
          \});\
        \}\
      \} else \{\
        panel.classList.add('hidden');\
        content.classList.remove('lg:grid-cols-12');\
        btnText.textContent = "Split Map";\
      \}\
    \}\
\
    function openPropertyVideoModal(id) \{\
      const item = properties.find(p => p.id === id);\
      if (!item) return;\
      document.getElementById('modal-tour-title').textContent = item.title;\
      document.getElementById('modal-tour-img').src = item.images[0];\
      document.getElementById('modal-whatsapp-action').onclick = () => quickWhatsAppContact(item.title, item.price);\
      document.getElementById('video-tour-modal').classList.remove('hidden');\
      document.getElementById('video-tour-modal').classList.add('flex');\
    \}\
\
    function openDemoTourModal() \{ openPropertyVideoModal(properties[0].id); \}\
    function closeVideoModal() \{\
      document.getElementById('video-tour-modal').classList.add('hidden');\
      document.getElementById('video-tour-modal').classList.remove('flex');\
    \}\
\
    function toggleSavedDrawer() \{\
      document.getElementById('saved-drawer').classList.toggle('translate-x-full');\
    \}\
\
    function quickWhatsAppContact(title, price) \{\
      window.open(`https://wa.me/2348000000000?text=$\{encodeURIComponent('Hello NaijaRentBeta, I want to inspect: ' + title)\}`, '_blank');\
    \}\
\
    document.addEventListener('DOMContentLoaded', () => \{\
      renderListings();\
      lucide.createIcons();\
    \});\
  </script>\
</body>\
</html>\
}